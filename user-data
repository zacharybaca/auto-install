#cloud-config
autoinstall:
  version: 1
  identity:
    hostname: surface-laptop
    password: '$6$REPLACE_WITH_HASHED_PASSWORD'
    realname: Your Full Name
    username: yourusername
  ssh:
    install-server: true
    allow-pw: false
  network:
    version: 2
    ethernets:
      usb0:
        dhcp4: true
        optional: true
    wifis:
      wlan0:
        dhcp4: true
        optional: true
        access-points:
          "YOUR_WIFI_SSID":
            password: "YOUR_WIFI_PASSWORD"
  keyboard:
    layout: us
  locale: en_US.UTF-8
  storage:
    layout:
      name: direct
      encrypt: true
      password: 'CHANGE_ME_LUKS_PASSWORD'
  snaps:
    - name: code
      classic: true
    - name: postman
  packages:
    - build-essential
    - curl
    - git
    - gnupg
    - wget
    - amd64-microcode
    - htop
    - jq
    - tmux
    - zsh
    - dkms
    - apt-transport-https
    - ripgrep
    - bat
    - wl-clipboard
    - fonts-firacode
    - ufw
    - fail2ban
    - gnome-tweaks
    - gnome-shell-extension-manager
    - papirus-icon-theme
    - arc-theme
    - unzip
    - zip
    - python3-pip
    - python3-venv
    - fzf
    - fd-find
    - tree
    - ncdu
    - neovim
    - stow
    - xdg-utils
  late-commands:
    - curtin in-target -- ufw allow ssh
    - curtin in-target -- ufw enable
    - curtin in-target -- systemctl enable fail2ban
    - curtin in-target -- su - yourusername -c 'mkdir -p ~/.ssh && chmod 700 ~/.ssh && echo "ssh-ed25519 YOUR_PUBLIC_KEY_HERE" >> ~/.ssh/authorized_keys && chmod 600 ~/.ssh/authorized_keys'
    - curtin in-target -- sh -c 'wget -qO - https://raw.githubusercontent.com/linux-surface/linux-surface/master/pkg/keys/surface.asc | gpg --dearmor > /etc/apt/trusted.gpg.d/linux-surface.gpg'
    - curtin in-target -- sh -c 'echo "deb [arch=amd64] https://pkg.surfacelinux.com/debian release main" > /etc/apt/sources.list.d/linux-surface.list'
    - curtin in-target -- apt-get update
    - curtin in-target -- apt-get install -y linux-image-surface linux-headers-surface libwacom-surface iptsd linux-surface-secureboot-mok surface-control
    - curtin in-target -- systemctl enable iptsd
    - curtin in-target -- sh -c 'curl -fsSL https://download.docker.com/linux/ubuntu/gpg | gpg --dearmor -o /etc/apt/keyrings/docker.gpg'
    - curtin in-target -- sh -c 'echo "deb [arch=amd64 signed-by=/etc/apt/keyrings/docker.gpg] https://download.docker.com/linux/ubuntu jammy stable" > /etc/apt/sources.list.d/docker.list'
    - curtin in-target -- apt-get update
    - curtin in-target -- apt-get install -y docker-ce docker-ce-cli containerd.io docker-compose-plugin
    - curtin in-target -- usermod -aG docker yourusername
    - curtin in-target -- systemctl enable docker
    - curtin in-target -- sh -c 'curl -fsSL https://www.mongodb.org/static/pgp/server-7.0.asc | gpg -o /usr/share/keyrings/mongodb-server-7.0.gpg --dearmor'
    - curtin in-target -- sh -c 'echo "deb [ arch=amd64,arm64 signed-by=/usr/share/keyrings/mongodb-server-7.0.gpg ] https://repo.mongodb.org/apt/ubuntu jammy/mongodb-org/7.0 multiverse" > /etc/apt/sources.list.d/mongodb-org-7.0.list'
    - curtin in-target -- apt-get update
    - curtin in-target -- apt-get install -y mongodb-org
    - curtin in-target -- systemctl enable mongod
    - curtin in-target -- su - yourusername -c 'curl -o- https://raw.githubusercontent.com/nvm-sh/nvm/v0.39.7/install.sh | bash'
    - curtin in-target -- su - yourusername -c 'export NVM_DIR="/home/yourusername/.nvm" && [ -s "$NVM_DIR/nvm.sh" ] && . "$NVM_DIR/nvm.sh" && nvm install --lts && npm install -g typescript ts-node nodemon pm2 yarn @angular/cli prettier eslint http-server'
    - curtin in-target -- su - yourusername -c 'sh -c "$(curl -fsSL https://raw.githubusercontent.com/ohmyzsh/ohmyzsh/master/tools/install.sh)" "" --unattended'
    - curtin in-target -- su - yourusername -c 'git clone https://github.com/zsh-users/zsh-autosuggestions ${ZSH_CUSTOM:-/home/yourusername/.oh-my-zsh/custom}/plugins/zsh-autosuggestions'
    - curtin in-target -- su - yourusername -c 'git clone https://github.com/zsh-users/zsh-syntax-highlighting ${ZSH_CUSTOM:-/home/yourusername/.oh-my-zsh/custom}/plugins/zsh-syntax-highlighting'
    - curtin in-target -- usermod -s /usr/bin/zsh yourusername
    - curtin in-target -- su - yourusername -c 'git config --global init.defaultBranch main'
    - curtin in-target -- su - yourusername -c 'git config --global pull.rebase true'

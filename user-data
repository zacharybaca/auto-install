    - curtin in-target -- apt-get update
    - curtin in-target -- apt-get install -y docker-ce docker-ce-cli containerd.io docker-compose-plugin
    - curtin in-target -- usermod -aG docker zacharybaca
    - curtin in-target -- sh -c 'curl -fsSL https://www.mongodb.org/static/pgp/server-7.0.asc | gpg -o /usr/share/keyrings/mongodb-server-7.0.gpg --dearmor'
    - curtin in-target -- sh -c 'echo "deb [ arch=amd64,arm64 signed-by=/usr/share/keyrings/mongodb-server-7.0.gpg ] https://repo.mongodb.org/apt/ubuntu jammy/mongodb-org/7.0 multiverse" > /etc/apt/sources.list.d/mongodb-org-7.0.list'
    - curtin in-target -- apt-get update
    - curtin in-target -- apt-get install -y mongodb-org
    - curtin in-target -- systemctl enable mongod
    - curtin in-target -- su - zacharybaca -c 'curl -o- https://raw.githubusercontent.com/nvm-sh/nvm/v0.39.7/install.sh | bash'
    - curtin in-target -- su - zacharybaca -c 'export NVM_DIR="/home/zacharybaca/.nvm" && [ -s "$NVM_DIR/nvm.sh" ] && . "$NVM_DIR/nvm.sh" && nvm install --lts && npm install -g typescript ts-node nodemon pm2 yarn @angular/cli'
    - curtin in-target -- su - zacharybaca -c 'sh -c "$(curl -fsSL https://raw.githubusercontent.com/ohmyzsh/ohmyzsh/master/tools/install.sh)" "" --unattended'
